# Copy to .env.local for development, and add the same keys in your host's
# environment settings (Vercel → Project → Settings → Environment Variables).

# --- Admin dashboard (/admin) -----------------------------------------------
# Password for the dashboard, at least 8 characters.
ADMIN_PASSWORD=
# Random secret used to sign the login cookie, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=

# --- Content (MongoDB Atlas) -------------------------------------------------
# Atlas → Connect → Drivers. Without it the site shows the built-in content
# from messages/*.json and the dashboard can't save.
MONGODB_URI=
# Optional, defaults to "portfolio".
MONGODB_DB=portfolio

# --- Uploads (Vercel Blob) ---------------------------------------------------
# Vercel → Storage → Blob → create a store. On Vercel this is added for you
# when the store is connected to the project; copy it here for local uploads.
BLOB_READ_WRITE_TOKEN=

# --- Existing ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
