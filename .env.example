# MongoDB Atlas connection string (Vercel → Storage → MongoDB Atlas integration also sets this)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority"
# Optional: database name if it isn't in the URI
MONGODB_DB=""

# Vercel Blob (created automatically when you connect a Blob store to the project)
BLOB_READ_WRITE_TOKEN=""

# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# First login only: used to create the admin account if none exists yet.
# After the first login, the password is stored hashed in MongoDB and can be changed from the dashboard.
ADMIN_EMAIL="aggamal98@gmail.com"
ADMIN_PASSWORD=""

# Optional: free WhatsApp notification for each contact message (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Phone in international format, e.g. +201149560988. Leave empty to disable.
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""

# Public URL used for SEO metadata / sitemap (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically)
NEXT_PUBLIC_SITE_URL=""
